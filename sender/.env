LISTEN=0.0.0.0:30000
HOST_URL=http://<host_ip>:40000
SELF_URL=http://<sender_ip>:30000
PASSPHRASE=some-shared-secret
SCHEME=
HTTP=true
# http/https routing by host. DOMAINS: comma separated; www.example.com (exact), *.example.com (subdomains), 192.168.1.10, 10.0.0.0/8
# DOMAIN_MODE=exclude: listed hosts open in your own browser, everything else is sent. include: only listed hosts are sent.
DOMAIN_MODE=exclude
DOMAINS=
# The browser used for local opening. At every start, if the OS default is another browser, it is written here and the Sender
# takes over; if the default already is the Sender, this value is used. Uninstall restores it as the default (macOS/Linux).
# macOS: bundle id or app name (com.kagi.kagimacos / Orion); Linux: firefox.desktop; Windows: ProgID or an .exe path
BROWSER=
